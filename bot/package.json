const state = {
  token: localStorage.getItem('nexus_token') || '',
  settings: {},
};

const loginView = document.getElementById('loginView');
const appView = document.getElementById('appView');
const statsGrid = document.getElementById('statsGrid');
const activitiesList = document.getElementById('activityList');
const recentTicketsList = document.getElementById('recentTicketsList');
const ticketsList = document.getElementById('ticketsList');
const panelsList = document.getElementById('panelsList');
const logsList = document.getElementById('logsList');
const settingsForm = document.getElementById('settingsForm');

async function apiFetch(path, options = {}) {
  const headers = {
    'Content-Type': 'application/json',
    ...(options.headers || {}),
  };

  if (state.token) {
    headers.Authorization = `Bearer ${state.token}`;
  }

  const response = await fetch(path, { ...options, headers });
  const json = await response.json();

  if (!response.ok) {
    throw new Error(json.message || 'Erro na requisição');
  }

  return json;
}

function renderStats(data) {
  const cards = [
    { label: 'Tickets criados', value: data.totals.tickets },
    { label: 'Abertos', value: data.totals.open },
    { label: 'Fechados', value: data.totals.closed },
    { label: 'Pendentes', value: data.totals.pending },
    { label: 'Em atendimento', value: data.totals.inProgress },
    { label: 'Painéis ativos', value: data.totals.activePanels },
  ];

  statsGrid.innerHTML = cards.map((card) => `
    <div class="stat-card">
      <span>${card.label}</span>
      <span class="value">${card.value}</span>
    </div>
  `).join('');

  activitiesList.innerHTML = (data.recentActivity || []).map((item) => `
    <li><strong>${item.action}</strong> · ${item.actor} · ${new Date(item.created_at).toLocaleString('pt-BR')}</li>
  `).join('') || '<li>Nenhuma atividade registrada.</li>';

  recentTicketsList.innerHTML = (data.recentTickets || []).map((ticket) => `
    <li><strong>#${ticket.id}</strong> · ${ticket.reason} · ${ticket.status}</li>
  `).join('') || '<li>Nenhum ticket recente.</li>';
}

function renderTickets(tickets) {
  ticketsList.innerHTML = `
    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Usuário</th>
          <th>Categoria</th>
          <th>Status</th>
          <th>Prioridade</th>
        </tr>
      </thead>
      <tbody>
        ${tickets.map((ticket) => `
          <tr>
            <td>#${ticket.id}</td>
            <td>${ticket.user_name || ticket.user_id}</td>
            <td>${ticket.category || 'Geral'}</td>
            <td>${ticket.status}</td>
            <td>${ticket.priority}</td>
          </tr>
        `).join('') || '<tr><td colspan="5">Nenhum ticket encontrado.</td></tr>'}
      </tbody>
    </table>
  `;
}

function renderPanels(panels) {
  panelsList.innerHTML = `
    <table>
      <thead>
        <tr>
          <th>Nome</th>
          <th>Título</th>
          <th>Canal</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        ${panels.map((panel) => `
          <tr>
            <td>${panel.name}</td>
            <td>${panel.title}</td>
            <td>${panel.channel_id || '—'}</td>
            <td>${panel.status}</td>
          </tr>
        `).join('') || '<tr><td colspan="4">Nenhum painel cadastrado.</td></tr>'}
      </tbody>
    </table>
  `;
}

function renderSettings(settings) {
  const defs = [
    'APP_NAME', 'BOT_STATUS', 'GUILD_ID', 'LOG_CHANNEL_ID', 'TICKET_CATEGORY_ID', 'SYNC_INTERVAL_MS', 'BOT_API_KEY', 'BOT_TOKEN'
  ];

  settingsForm.innerHTML = defs.map((key) => `
    <label>
      ${key}
      <input name="${key}" value="${settings[key] || ''}" placeholder="${key}" />
    </label>
  `).join('') + `
    <button type="submit" class="primary-btn">Salvar configurações</button>
  `;
}

function renderLogs(logs) {
  logsList.innerHTML = `
    <table>
      <thead>
        <tr>
          <th>Ação</th>
          <th>Ator</th>
          <th>Data</th>
        </tr>
      </thead>
      <tbody>
        ${logs.map((item) => `
          <tr>
            <td>${item.action}</td>
            <td>${item.actor}</td>
            <td>${new Date(item.created_at).toLocaleString('pt-BR')}</td>
          </tr>
        `).join('') || '<tr><td colspan="3">Sem registros de auditoria.</td></tr>'}
      </tbody>
    </table>
  `;
}

async function loadDashboard() {
  const data = await apiFetch('/api/dashboard');
  renderStats(data.data);
}

async function loadTickets() {
  const data = await apiFetch('/api/tickets');
  renderTickets(data.tickets);
}

async function loadPanels() {
  const data = await apiFetch('/api/panels');
  renderPanels(data.panels);
}

async function loadSettings() {
  const data = await apiFetch('/api/settings');
  state.settings = data.settings || {};
  renderSettings(state.settings);
}

async function loadLogs() {
  const data = await apiFetch('/api/logs');
  renderLogs(data.logs || []);
}

async function refreshAll() {
  await Promise.all([
    loadDashboard(),
    loadTickets(),
    loadPanels(),
    loadSettings(),
    loadLogs(),
  ]);
}

function toggleAuth() {
  const isLogged = Boolean(state.token);
  loginView.classList.toggle('hidden', isLogged);
  appView.classList.toggle('hidden', !isLogged);
}

async function handleLogin(event) {
  event.preventDefault();
  const email = document.getElementById('emailInput').value;
  const password = document.getElementById('passwordInput').value;

  try {
    const result = await fetch('/api/auth/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email, password }),
    }).then((res) => res.json());

    if (!result.ok) {
      throw new Error(result.message || 'Falha ao entrar');
    }

    state.token = result.token;
    localStorage.setItem('nexus_token', result.token);
    toggleAuth();
    refreshAll();
  } catch (error) {
    alert(error.message || 'Erro ao entrar');
  }
}

document.getElementById('loginForm').addEventListener('submit', handleLogin);
document.getElementById('logoutBtn').addEventListener('click', () => {
  state.token = '';
  localStorage.removeItem('nexus_token');
  toggleAuth();
});

document.querySelectorAll('.nav-item').forEach((button) => {
  button.addEventListener('click', () => {
    document.querySelectorAll('.nav-item').forEach((item) => item.classList.remove('active'));
    document.querySelectorAll('.view').forEach((view) => view.classList.remove('active'));
    button.classList.add('active');
    const target = button.dataset.view;
    document.getElementById(target).classList.add('active');
  });
});

settingsForm.addEventListener('submit', async (event) => {
  event.preventDefault();
  const formData = new FormData(settingsForm);
  const payload = Object.fromEntries(formData.entries());
  await apiFetch('/api/settings', { method: 'POST', body: JSON.stringify(payload) });
  alert('Configurações salvas');
  refreshAll();
});

document.getElementById('createTicketBtn').addEventListener('click', async () => {
  const text = prompt('Descreva o motivo do ticket:');
  if (!text) return;
  await apiFetch('/api/tickets', {
    method: 'POST',
    body: JSON.stringify({ user_id: 'web-user', user_name: 'Usuário web', category: 'Suporte geral', reason: text }),
  });
  refreshAll();
});

document.getElementById('createPanelBtn').addEventListener('click', async () => {
  const name = prompt('Nome do painel:');
  if (!name) return;
  await apiFetch('/api/panels', {
    method: 'POST',
    body: JSON.stringify({ name, title: name, description: 'Painel novo', status: 'draft' }),
  });
  refreshAll();
});

if (!state.token) {
  toggleAuth();
} else {
  toggleAuth();
  refreshAll();
}
